{
  "name": "resume-rewriter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node --import tsx scripts/smoke-test.ts",
    "doctor": "node --import tsx scripts/doctor.ts",
    "setup:latex": "node scripts/setup-latex.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "openai": "^7.15.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
